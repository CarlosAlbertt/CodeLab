{
  "name": "codelab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare:libs": "node scripts/build-ts-lib.mjs",
    "dev": "npm run prepare:libs && vite",
    "build": "npm run prepare:libs && vue-tsc --noEmit && vite build",
